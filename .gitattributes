# Auto detect text files and perform LF normalization
* text=auto

# Enforce Unix line endings for shell scripts and gradlew
gradlew text eol=lf
*.sh text eol=lf

# Enforce Windows line endings for batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.db binary
*.png binary
*.jpg binary
